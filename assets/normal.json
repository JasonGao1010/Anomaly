  "definitions": {
    "nuScenes_annotations": {
      "url": "https://github.com/nutonomy/nuscenes-devkit/blob/master/docs/instructions_nuscenes.md",
      "applied": "Bicycle and motorcycle boxes include the rider; nearby standing people are annotated separately; cycle.with_rider supplies positive rider evidence, cycle.without_rider does not establish absence of a nearby person. The motorcycle category also includes light three-wheel vehicles. Police vehicles include police bicycles and motorcycles."
    },
    "nuScenes_lidarseg": {
      "url": "https://github.com/nutonomy/nuscenes-devkit/blob/master/docs/instructions_lidarseg.md",
      "applied": "Existing foreground definitions carry into point labels. driveable_surface includes paved and unpaved surfaces independent of traffic rules. Terrain includes a delimiting curb and bushes below 20 cm. Semantic names are authoritative here; numeric IDs are verified against local lidarseg/category.json."
    },
    "SemanticKITTI": {
      "url": "https://openaccess.thecvf.com/content_ICCV_2019/supplemental/Behley_SemanticKITTI_A_Dataset_ICCV_2019_supplemental.pdf",
      "applied": "Table 1: bicycle/motorcycle with a rider or a person within arm reach uses the rider category. Sidewalk includes curbs and private driveways; other-ground includes paved fuel-station areas; vegetation includes bushes. Parking is explicitly designated and separated from sidewalk/road; ambiguous ground remains a set label. A bicycle and its rider are not separated into different classes."
    }
  },
  "source_policy": {
    "human.pedestrian": [
      "person",
      "bicyclist",
      "motorcyclist"
    ],
    "flat.driveable_surface": [
      "road",
      "parking",
      "sidewalk",
      "other-ground"
    ],
    "flat.terrain": [
      "sidewalk",
      "vegetation",
      "terrain"
    ],
    "vehicle.motorcycle": [
      "motorcycle",
      "other-vehicle",
      "motorcyclist"
    ],
    "vehicle.motorcycle_with_rider": [
      "other-vehicle",
      "motorcyclist"
    ],
    "vehicle.bicycle_with_rider": [
      "bicyclist"
    ],
    "cycle_attribute_refinement": "Intersect original same-class lidarseg points with exactly one unexpanded official cuboid; without_rider and unmatched/overlapping points keep their coarse set. Only actual singleton labels qualify for rare-class replay."
  }
}
